# Staging — GCP Cloud SQL staging instance via Cloud SQL Proxy.
# Copy: cp env/examples/.env.staging.example .env.staging
# Fill in DB_PASSWORD (ask a team lead). Then:
#   make migrate-staging && make staging
#
# make staging / make migrate-staging start the proxy on port 5433 automatically.
# Standalone proxy: make proxy-staging
# Requires: gcloud auth application-default login, and ./cloud_sql_proxy in the repo root.

DEBUG=True
SECRET_KEY=staging-not-for-production-replace-me
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

USE_CLOUD_SQL=True
USE_LOCAL_POSTGRES=False
USE_SQLITE=False

USE_GCS=True
GS_BUCKET_NAME=carnitrack-bucket
GS_LOCATION=staging

DB_NAME=carnitrack_db
DB_USER=django_staging
DB_PASSWORD=<ask-team-lead-for-staging-password>
DB_HOST=127.0.0.1
DB_PORT=5433

CLOUD_SQL_CONNECTION_NAME=carnitrack:europe-west1:carnitrack-db-belgium-staging

DATABASE_CONTEXT_LABEL="STAGING | db=carnitrack_db (Cloud SQL staging)"

STATIC_URL=/static/
MEDIA_URL=/media/

TIME_ZONE=Europe/Istanbul
DJANGO_LOG_LEVEL=INFO

SECURE_SSL_REDIRECT=False
SECURE_BROWSER_XSS_FILTER=False
SECURE_CONTENT_TYPE_NOSNIFF=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

LANGUAGE_CODE=tr
USE_I18N=True
USE_L10N=True
USE_TZ=True

# Redis (sessions + cache; use rediss:// for TLS)
REDIS_URL=redis://127.0.0.1:6379/0

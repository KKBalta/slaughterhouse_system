# Production-like local run — Gunicorn against real prod Cloud SQL via proxy.
# Copy: cp env/examples/.env.production.example .env.production
# Replace secrets. Start the prod Cloud SQL proxy first, then:
#   make proxy          # default: 127.0.0.1:5434 → carnitrack-db-belgium
#   make production-local
#
# Requires: gcloud auth application-default login, ./cloud_sql_proxy

DEBUG=False
SECRET_KEY=replace-with-50-char-random-string

# Django host for Cloud Run service URL + any custom domains (no port for HTTPS).
# Include a wildcard like .carnitrack.yourdomain.com so tenant hostnames can be derived, OR set TENANT_BASE_DOMAIN explicitly.
ALLOWED_HOSTS=your-service-url.run.app,app.carnitrack.samperlabs.com,.carnitrack.samperlabs.com

# Optional: tenant suffix for {schema}.<TENANT_BASE_DOMAIN>. If unset, derived from the first
# wildcard in ALLOWED_HOSTS (e.g. .carnitrack.example.com -> carnitrack.example.com).
# TENANT_BASE_DOMAIN=carnitrack.yourdomain.com

# Every origin that sends cross-origin requests to Django (SPA domain, API domain,
# any tenant subdomains). Must include scheme + host, no trailing slash.
CSRF_TRUSTED_ORIGINS=https://your-service-url.run.app,https://app.carnitrack.samperlabs.com,https://api.carnitrack.samperlabs.com

# Every SPA / browser origin that calls the Django API from a different origin.
CORS_ALLOWED_ORIGINS=https://app.carnitrack.samperlabs.com
CORS_ALLOW_CREDENTIALS=True

# SPA and API share the same registerable domain (samperlabs.com) → same-site.
# SameSite=Lax is therefore sufficient and does NOT require SameSite=None.
# If the SPA is on a completely different domain, change both to "none" and
# ensure SESSION_COOKIE_SECURE=True (required for SameSite=None to be accepted).
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
# Must be False so the SPA can read the csrftoken cookie and send X-CSRFToken.
CSRF_COOKIE_HTTPONLY=False
# Leave cookie domains unset so each tenant cookie is host-specific.
# SESSION_COOKIE_DOMAIN=
# CSRF_COOKIE_DOMAIN=

USE_CLOUD_SQL=True
USE_LOCAL_POSTGRES=False
USE_SQLITE=False

USE_GCS=True
GS_BUCKET_NAME=carnitrack-bucket

DB_NAME=carnitrack_db
DB_USER=django_user
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=5434

CLOUD_SQL_CONNECTION_NAME=carnitrack:europe-west1:carnitrack-db-belgium

DATABASE_CONTEXT_LABEL="PRODUCTION (local via proxy) | db=carnitrack_db"

STATIC_URL=/static/
MEDIA_URL=/media/

TIME_ZONE=Europe/Istanbul
DJANGO_LOG_LEVEL=INFO

# Keep SECURE_SSL_REDIRECT=False when running locally via proxy (TLS terminates at
# the load balancer / Cloud Run, not at Gunicorn). Set True only if Gunicorn itself
# terminates TLS (rare for Cloud Run).
SECURE_SSL_REDIRECT=False
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Optional: enable HSTS once HTTPS is stable. Start low, raise after validation.
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

LANGUAGE_CODE=tr
USE_I18N=True
USE_L10N=True
USE_TZ=True

# Redis (sessions + cache; use rediss:// for TLS in Cloud)
REDIS_URL=rediss://:replace-with-redis-password@your-redis-host:6380/0

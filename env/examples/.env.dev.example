# Local development — PostgreSQL on this machine (not Cloud SQL).
# Copy to repo root:  cp env/examples/.env.dev.example .env.dev
# Then: make db-setup-dev && make migrate-dev && make dev

DEBUG=True
SECRET_KEY=django-insecure-dev-only-change-me
# `.localhost` allows tenant subdomains (e.g. dev.localhost / api.carnitrack.localhost).
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://api.carnitrack.localhost:8000,http://localhost:3000,http://carnitrack.localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://carnitrack.localhost:3000
CORS_ALLOW_CREDENTIALS=True
# Leave cookie domains unset in local dev so cookies are host-only
# (api.carnitrack.localhost) and reliably accepted by browsers.
# SESSION_COOKIE_DOMAIN=
# CSRF_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
CSRF_COOKIE_HTTPONLY=False

USE_CLOUD_SQL=False
USE_LOCAL_POSTGRES=True
USE_SQLITE=False

USE_GCS=False

DB_NAME=carnitrack_dev
DB_USER=carnitrack_dev
DB_PASSWORD=carnitrack_dev
DB_HOST=127.0.0.1
DB_PORT=5432

# Startup banner + log line (optional; defaults to auto-detected LOCAL DEV … if unset)
DATABASE_CONTEXT_LABEL="DEV_CARNITRACK | db=carnitrack_dev"

STATIC_URL=/static/
MEDIA_URL=/media/

TIME_ZONE=Europe/Istanbul
DJANGO_LOG_LEVEL=DEBUG

SECURE_SSL_REDIRECT=False
SECURE_BROWSER_XSS_FILTER=False
SECURE_CONTENT_TYPE_NOSNIFF=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

LANGUAGE_CODE=tr
USE_I18N=True
USE_L10N=True
USE_TZ=True

# Redis (local: brew services start redis)
REDIS_URL=redis://127.0.0.1:6379/0
# If Redis is stopped: with DEBUG=True, app falls back to LocMemCache (OK for runserver; not for multi-worker Gunicorn).
# REDIS_FALLBACK_TO_LOCMEM=False

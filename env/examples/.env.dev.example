# Local development — PostgreSQL on this machine (not Cloud SQL).
# Copy to repo root:  cp env/examples/.env.dev.example .env.dev
# Then: make db-setup-dev && make migrate-dev && make dev

DEBUG=True
SECRET_KEY=django-insecure-dev-only-change-me
# `.localhost` allows tenant subdomains (e.g. dev.localhost / api.carnitrack.localhost).
# Public API + tenant-registration: same list must include your API host (e.g. api.carnitrack.localhost).
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.localhost

# List every SPA origin AND every Django API origin here so CSRF validation passes for
# cross-origin POSTs (login/logout). Add tenant subdomains as you create them.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://api.carnitrack.localhost:8000,http://localhost:3000,http://carnitrack.localhost:3000,http://dev.localhost:3000

# Every SPA origin that calls the Django API must be listed here. Prefer the tenant host
# (e.g. http://pomet.localhost:3000) when using session cookies with the tenant API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://carnitrack.localhost:3000,http://dev.localhost:3000
CORS_ALLOW_CREDENTIALS=True
# DEBUG=True: config/settings.py adds CORS_ALLOWED_ORIGIN_REGEXES for *.localhost and extends
# CSRF_TRUSTED_ORIGINS with http(s)://*.localhost:3000 (and :5173) so http://pomet.localhost:3000
# works without editing this file per tenant. Disable with CORS_DEV_LOCALHOST_REGEX=False or
# CSRF_DEV_TRUST_LOCALHOST=False.
#
# Point the React API base at the selected tenant’s host from discover-tenants (api_base_url), e.g.
# http://pomet.localhost:8000 — not a fixed http://api.carnitrack.localhost:8000 unless that host
# is the one you intend (django-tenants routes by Host header).
# If the SPA stays on localhost:3000, POST /api/v1/auth/login/ returns session_pending +
# session_bootstrap_url — the React app must set window.location to that URL (same tab) so
# GET /api/v1/auth/session-bootstrap/ can set the session cookie first-party.

# Cross-origin dev: SPA on :3000 calls tenant API on *.localhost:8000 — a different
# site than http://localhost:3000, so SameSite=Lax blocks cross-site fetch cookies.
# Use SESSION_COOKIE_SAMESITE=none here. Chrome still requires Secure=True for
# SameSite=None on hosts like pomet.localhost (only exact "localhost" gets the HTTP
# exception). For reliable SSO without HTTPS, run the SPA on the same tenant host
# as the API (e.g. http://pomet.localhost:3000 → http://pomet.localhost:8000), same-site.
#
# Leave cookie *domains* unset so each tenant cookie is host-specific
# (e.g. farm1.localhost:8000) and not accidentally sent to other subdomains.
# SESSION_COOKIE_DOMAIN=
# CSRF_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=none
CSRF_COOKIE_SAMESITE=none
# Must be False so JS can read the cookie and send it as X-CSRFToken.
CSRF_COOKIE_HTTPONLY=False

USE_CLOUD_SQL=False
USE_LOCAL_POSTGRES=True
USE_SQLITE=False

USE_GCS=False

DB_NAME=carnitrack_dev
DB_USER=carnitrack_dev
DB_PASSWORD=carnitrack_dev
DB_HOST=127.0.0.1
DB_PORT=5432

# Startup banner + log line (optional; defaults to auto-detected LOCAL DEV … if unset)
DATABASE_CONTEXT_LABEL="DEV_CARNITRACK | db=carnitrack_dev"

STATIC_URL=/static/
MEDIA_URL=/media/

TIME_ZONE=Europe/Istanbul
DJANGO_LOG_LEVEL=INFO

SECURE_SSL_REDIRECT=False
SECURE_BROWSER_XSS_FILTER=False
SECURE_CONTENT_TYPE_NOSNIFF=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

LANGUAGE_CODE=tr
USE_I18N=True
USE_L10N=True
USE_TZ=True

# Tenant hostnames: {schema}.<suffix>. With DEBUG=True, TENANT_BASE_DOMAIN defaults to localhost
# if unset. Override explicitly if needed:
# TENANT_BASE_DOMAIN=localhost

# Redis (local: brew services start redis)
REDIS_URL=redis://127.0.0.1:6379/0

# Tenant discovery URLs for *.localhost (email-first login flow)
# PUBLIC_TENANT_HTTP_PORT=8000
# PUBLIC_TENANT_WEB_HTTP_PORT=3000
# TENANT_LOGIN_SUCCESS_REDIRECT_PATH=/dashboard
# Post-login browser URL: Django (API host :8000) vs SPA (:3000). True = templates/Django dashboard phase.
# TENANT_POST_LOGIN_USE_API_HOST=True
# Or per-request from React: POST /api/v1/auth/login/ JSON { "post_login_redirect": "django" } (same session for Django pages).
# If Redis is stopped: with DEBUG=True, app falls back to LocMemCache (OK for runserver; not for multi-worker Gunicorn).
# REDIS_FALLBACK_TO_LOCMEM=False
